#!/usr/bin/env python3
"""Stand-in for a-Shell's ``jsc`` command, talking to the fake webview in webview.mjs.

``jsc FILE`` evaluates FILE in the page and prints its completion value; ``jsc --reset``
asks the page to reload and returns at once. When the page does not answer, this waits
forever, as the real command does -- the caller's timeout is what ends it.
"""

import json
import os
import socket
import sys


def main() -> int:
    if sys.argv[1:] == ['--reset']:
        message = {'op': 'reset'}
    elif len(sys.argv) == 2:
        with open(sys.argv[1], encoding='utf-8') as script:
            message = {'op': 'eval', 'source': script.read()}
    else:
        print('usage: jsc FILE | jsc --reset', file=sys.stderr)
        return 2

    with socket.socket(socket.AF_UNIX) as connection:
        connection.connect(os.environ['FAKE_WEBVIEW_SOCKET'])
        connection.sendall(json.dumps(message).encode() + b'\n')
        reply = b''
        while chunk := connection.recv(65536):
            reply += chunk

    result = json.loads(reply)
    sys.stdout.write(result['stdout'])
    sys.stderr.write(result['stderr'])
    return result['code']


if __name__ == '__main__':
    sys.exit(main())
